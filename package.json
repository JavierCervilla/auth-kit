{
  "name": "@universelle/auth-kit",
  "version": "0.0.0",
  "description": "Optional sign-in for web games and apps: guest play, magic link and email code, on better-auth with Postgres.",
  "license": "MIT",
  "author": "Universelle",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JavierCervilla/auth-kit.git"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./mail": {
      "types": "./dist/mail/index.d.ts",
      "default": "./dist/mail/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@types/node": "22.20.5",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.3",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "dependencies": {
    "better-auth": "1.7.10",
    "drizzle-orm": "0.45.4",
    "nodemailer": "10.1.7"
  }
}
